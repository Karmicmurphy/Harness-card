{
  "name": "Harness Card",
  "version": "0.3.0",
  "purpose": "Canonical AI operating harness for intent recovery, continuity, skill routing, bounded execution, proof, learning, automation, and closeout across projects.",
  "manual_triggers": [
    "Use Harness Card",
    "Use Harness Card and continue",
    "Harness this",
    "Run the harness"
  ],
  "bootstrap_files": [
    "AGENTS.md",
    "OPERATING_CONTRACT.md",
    "ROUTING.md",
    "state/CURRENT_PROJECT.json",
    "state/ACTIVE_WORK_ORDER.md",
    "state/LEARNING_CANDIDATES.json",
    "projects/PROJECT_INDEX.md",
    "skills/SKILL_SOURCES.md",
    "config/skill_registry.json",
    "config/friday_automation_policy.json"
  ],
  "evidence_states": [
    "CLAIMED",
    "IMPLEMENTED_UNPROVEN",
    "PARTIALLY_PROVEN",
    "PROVEN_IN_TEST",
    "PROVEN_LIVE",
    "FAILED",
    "BLOCKED",
    "RETIRED"
  ],
  "terminal_states": [
    "DONE",
    "BLOCKED",
    "FAILED",
    "RETIRED"
  ],
  "privacy": {
    "repository_expected_public": true,
    "allow_secrets": false,
    "allow_sensitive_personal_data": false
  },
  "skill_resolution": {
    "registry": "config/skill_registry.json",
    "resolver": "scripts/resolve_skill.py",
    "rule": "Every routed skill must resolve to one canonical repo/path/ref before use."
  },
  "automation": {
    "policy": "config/friday_automation_policy.json",
    "mode": "AUTOMATE_UNTIL_OWNER_GATE",
    "owner_view_builder": "scripts/friday_control_plane.py",
    "learning_inbox": "state/LEARNING_CANDIDATES.json",
    "rule": "Automate bounded reversible evidence-producing work; stop at explicit owner gates."
  }
}
